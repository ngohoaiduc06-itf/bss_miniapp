{% if request.page_type == 'product' %}
  <script>
  (function () {
    const product = {{ product | json }};
    const rules = {{ shop.metafields.bss.custom_pricing_rules.value | default: '[]' | json }};
    const moneyFormat = {{ shop.money_format | json }};

    if (!product || !rules.length) return;

    const productTags = new Set((product.tags || []).map(t => t.trim().toLowerCase()));

    const activeRule = rules
      .filter(rule => {
        if (rule.status !== "enable") return false;
        if (rule.applyTo === "all") return true;
        if (rule.applyTo === "tags" && Array.isArray(rule.tags)) {
          return rule.tags.some(tag => productTags.has(tag.trim().toLowerCase()));
        }
        return false;
      })
      .sort((a, b) => Number(a.priority) - Number(b.priority))[0];

    const styleEl = document.createElement('style');
    styleEl.innerHTML = '.price__badge-sale { display: none !important; }';
    document.head.appendChild(styleEl);

    const variantMap = new Map(product.variants.map(v => [String(v.id), v]));

    function calculatePrice(originalPrice, rule) {
      const val = Number(rule?.value);
      if (!rule || !Number.isFinite(val)) return originalPrice;

      switch (rule.pricingType) {
        case "fixedPrice":
          return Math.max(0, val);
        case "fixedDiscount":
          return Math.max(0, originalPrice - val);
        case "percentage":
          return Math.max(0, originalPrice * (1 - val / 100));
        default:
          return originalPrice;
      }
    }

    function formatMoney(cents, format) {
      let value = '';
      const placeholderRegex = /\{\{\s*(\w+)\s*\}\}/;

      function formatWithDelimiters(number, precision = 2, thousands = ',', decimals = '.') {
        if (isNaN(number) || number == null) return 0;
        number = (number / 100).toFixed(precision);
        const parts = number.split('.');
        return parts[0].replace(/(\d)(?=(\d\d\d)+(?!\d))/g, '$1' + thousands) + (parts[1] ? decimals + parts[1] : '');
      }

      switch (format.match(placeholderRegex)?.[1]) {
        case 'amount':
          value = formatWithDelimiters(cents, 2);
          break;
        case 'amount_no_decimals':
          value = formatWithDelimiters(cents, 0);
          break;
        case 'amount_with_comma_separator':
          value = formatWithDelimiters(cents, 2, '.', ',');
          break;
        case 'amount_no_decimals_with_comma_separator':
          value = formatWithDelimiters(cents, 0, '.', ',');
          break;
        default:
          value = (cents / 100).toFixed(2);
      }

      return format.replace(placeholderRegex, value);
    }

    function getCurrentVariant() {
      const urlParams = new URLSearchParams(window.location.search);
      const variantIdFromUrl = urlParams.get('variant');
      if (variantIdFromUrl && variantMap.has(variantIdFromUrl)) {
        return variantMap.get(variantIdFromUrl);
      }

      const variantInput = document.querySelector('form[action*="/cart/add"] [name="id"]');
      if (variantInput?.value && variantMap.has(String(variantInput.value))) {
        return variantMap.get(String(variantInput.value));
      }
      return product.variants[0] || null;
    }
    
    let isUpdatingDOM = false;

    function applyPricing() {
      const variant = getCurrentVariant();
      if (!variant) return;

      const originalPrice = Number(variant.price || 0);
      const discountedPrice = calculatePrice(originalPrice, activeRule);

      if (!Number.isFinite(originalPrice) || originalPrice <= 0) {
        return;
      }

      const formattedOriginal = formatMoney(originalPrice, moneyFormat);
      const formattedDiscounted = formatMoney(discountedPrice, moneyFormat);

      isUpdatingDOM = true;

      document.querySelectorAll(".price").forEach((container) => {
        const regularBlock = container.querySelector(".price__regular");
        const saleBlock = container.querySelector(".price__sale");

        const salePrice = container.querySelector(".price__sale .price-item--sale");
        const comparePrice = container.querySelector(".price__sale s.price-item--regular");
        const regularPrice = container.querySelector(".price__regular .price-item--regular");

        if (discountedPrice < originalPrice) {
          if (saleBlock && salePrice) {
            if (comparePrice && comparePrice.textContent !== formattedOriginal) {
              comparePrice.textContent = formattedOriginal;
            }

            if (salePrice.textContent !== formattedDiscounted) {
              salePrice.textContent = formattedDiscounted;
              salePrice.style.color = "#d82c0d";
            }

            saleBlock.classList.remove("hidden");
            saleBlock.style.display = "";

            if (regularBlock) {
              regularBlock.classList.add("hidden");
              regularBlock.style.display = "none";
            }
          } else if (regularPrice) {
            if (regularPrice.dataset.bssOriginal === undefined) {
              regularPrice.dataset.bssOriginal = regularPrice.innerHTML;
            }

            const customHTML = `<s class="price-item price-item--regular" style="text-decoration: line-through; opacity: 0.7; margin-right: 8px;">${formattedOriginal}</s><span class="price-item price-item--sale" style="color: #d82c0d; font-weight: bold;">${formattedDiscounted}</span>`;

            if (regularPrice.innerHTML !== customHTML) {
              regularPrice.innerHTML = customHTML;
            }
          }

          container.classList.add("price--on-sale");
        } 
        else if (activeRule.pricingType === "fixedPrice") {
          if (regularPrice) {
            if (regularPrice.dataset.bssOriginal === undefined) {
              regularPrice.dataset.bssOriginal = regularPrice.innerHTML;
            }
            if (regularPrice.textContent !== formattedDiscounted) {
              regularPrice.textContent = formattedDiscounted;
            }
          }
          if (salePrice && salePrice.textContent !== formattedDiscounted) {
            salePrice.textContent = formattedDiscounted;
          }
        }
      });

      setTimeout(() => {
        isUpdatingDOM = false;
      }, 100);
    }

    function initListeners() {
      window.addEventListener("popstate", applyPricing);

      const productForm = document.querySelector('form[action*="/cart/add"]');
      if (productForm) {
        productForm.addEventListener("change", () => {
          setTimeout(applyPricing, 50);
        });
      }

      const targetNodes = document.querySelectorAll(".price");
      if (targetNodes.length > 0) {
        const observer = new MutationObserver(() => {
          if (!isUpdatingDOM) {
            applyPricing();
          }
        });

        targetNodes.forEach(node => {
          observer.observe(node, { childList: true, subtree: true, characterData: true });
        });
      }
    }

    if (document.readyState === "loading") {
      document.addEventListener("DOMContentLoaded", () => {
        applyPricing();
        initListeners();
      });
    } else {
      applyPricing();
      initListeners();
    }

  })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Custom Pricing",
  "target": "body",
  "settings": []
}
{% endschema %}