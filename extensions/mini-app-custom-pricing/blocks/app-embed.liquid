{% if request.page_type == 'product' %}
  <style>
    .price__badge-sale { display: none !important; }
  </style>

  <script>
    (function () {
      if (window.__bssPricingApplied) return;
      window.__bssPricingApplied = true;

      const product = {{ product | json }};
      const rules = {{ shop.metafields.bss.custom_pricing_rules.value | default: '[]' | json }};
      const moneyFormat = {{ shop.money_format | json }};

      // LOG 1: Check dữ liệu đầu vào từ Shopify
      console.log("[BSS Custom Pricing] Init Data:", { product, rules, moneyFormat });

      // 1. Kiểm tra Rule có hợp lệ không
      function isRuleApplicable(rule) {
        if (rule.status !== "enable") return false;
        if (rule.applyTo === "all") return true;
        if (rule.applyTo === "tags") {
          const productTags = (product.tags || []).map(t => t.trim().toLowerCase());
          const ruleTags = (rule.tags || []).map(t => t.trim().toLowerCase());
          return ruleTags.some(tag => productTags.includes(tag));
        }
        return false;
      }

      // 2. Tính giá sau giảm
      function calculatePrice(originalPrice, rule) {
        const val = Number(rule?.value);
        if (!rule || !Number.isFinite(val)) return originalPrice;

        switch (rule.pricingType) {
          case "fixedPrice": return Math.max(0, val);
          case "fixedDiscount": return Math.max(0, originalPrice - val);
          case "percentage": return Math.max(0, originalPrice * (1 - val / 100));
          default: return originalPrice;
        }
      }

      // 3. Format giá tien
      function formatMoney(cents, format) {
        const value = (Number(cents) / 100).toFixed(2);
        const valNoDec = Math.round(cents / 100).toString();

        return format
          .replace(/\{\{\s*amount\s*\}\}/, value)
          .replace(/\{\{\s*amount_no_decimals\s*\}\}/, valNoDec)
          .replace(/\{\{\s*amount_with_comma_separator\s*\}\}/, value.replace(".", ","))
          .replace(/\{\{\s*amount_no_decimals_with_comma_separator\s*\}\}/, valNoDec.replace(".", ","));
      }

      // 4. Lấy Rule có ưu tiên cao nhất
      const activeRule = rules
        .filter(isRuleApplicable)
        .sort((a, b) => Number(a.priority) - Number(b.priority))[0];

      if (!activeRule) {
        console.log("[BSS Custom Pricing] No applicable rule found.");
        return;
      }

      const origPrice = Number(product?.variants?.[0]?.price || 0);
      const discPrice = calculatePrice(origPrice, activeRule);

      if (discPrice >= origPrice) {
        console.log("[BSS Custom Pricing] Price not reduced, skipping.", { origPrice, discPrice });
        return;
      }

      const formattedOrig = formatMoney(origPrice, moneyFormat);
      const formattedDisc = formatMoney(discPrice, moneyFormat);

      // LOG 2: Check Rule được chọn & Giá sau khi tính toán
      console.log("[BSS Custom Pricing] Applied Rule & Prices:", {
        rule: activeRule,
        originalPrice: formattedOrig,
        discountedPrice: formattedDisc
      });

      // 5. Cập nhật giao diện Rise Theme
      document.querySelectorAll(".price").forEach((container) => {
        const saleBlock = container.querySelector(".price__sale");
        if (!saleBlock) return;

        const compareEl = saleBlock.querySelector("s.price-item--regular");
        const saleEl = saleBlock.querySelector(".price-item--sale");

        if (compareEl) compareEl.textContent = formattedOrig;
        if (saleEl) {
          saleEl.textContent = formattedDisc;
          saleEl.style.color = "#d82c0d";
        }

        saleBlock.classList.remove("hidden");
        saleBlock.style.display = "";

        const regularBlock = container.querySelector(".price__regular");
        if (regularBlock) {
          regularBlock.classList.add("hidden");
          regularBlock.style.display = "none";
        }

        container.classList.add("price--on-sale");
      });
    })();
  </script>
{% endif %}

{% schema %}
{
  "name": "Custom Pricing",
  "target": "body",
  "settings": []
}
{% endschema %}